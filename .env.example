# NER-SHIELD AI — Environment Variables
# Copy this file to .env and fill in the values

# ── Application ───────────────────────────────────────────────
APP_NAME="NER-SHIELD AI"
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://<database-user>:<database-password>@localhost:5432/<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<database-password>
POSTGRES_DB=<database-name>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="NER-SHIELD AI"
NEXT_PUBLIC_DEMO_MODE=true

# ── File Storage ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── AI / ML ───────────────────────────────────────────────────
AI_MODEL_PATH=./app/ai/models
ENABLE_IMAGE_CLASSIFICATION=true

# ── External APIs (Optional - for production) ─────────────────
# OPENWEATHER_API_KEY=your_key_here
# GOOGLE_MAPS_API_KEY=your_key_here
# NIC_TRANSPORT_API_KEY=your_key_here

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
